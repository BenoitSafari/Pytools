# EditorConfig — consistent formatting across editors/IDEs.
# https://editorconfig.org  (native support in VS Code, JetBrains, Vim, etc.)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,sh}]
indent_size = 4

[*.ps1]
indent_size = 4

[*.{toml,md,yaml,yml,json,csv}]
indent_size = 2

# Makefiles (if any) require tabs.
[Makefile]
indent_style = tab
